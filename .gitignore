# local state: token, summaries, backlog, history
state/
__pycache__/
*.pyc
# the agents' worktrees (claude --worktree)
.claude/worktrees/
# types Claude Code writes next to the mod when it loads it
mod/.claude-plugin/types/
# library icons and their catalog: generated by bin/diagram catalog.
# Azure, generic and onprem are in the repo: they are there even if the library cannot be copied.
icons/library/*
!icons/library/azure/
!icons/library/generic/
!icons/library/onprem/
icons/catalog.csv
# notebooks: personal notes, with their own git repo (autosave)
notebooks/
# project list: local to each machine (starts empty)
projects.json
